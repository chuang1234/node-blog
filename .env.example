# ===== docker compose 部署环境变量 =====
# 复制为 .env 后按需修改，deploy.sh 会自动完成这一步

# 站点对外暴露端口（云服务器安全组需放行此端口）
HTTP_PORT=80

# 数据库（root 账号；应用直连 root，简单够用）
DB_USER=root
DB_PASSWORD=Chuang@123456
DB_NAME=ai_blog

# JWT 签名密钥（生产环境务必改成一段足够长的随机串）
JWT_SECRET=please_change_this_to_a_long_random_string

# 跨域白名单（同源部署填 * 即可；前后端不同域则填前端域名，多域名逗号分隔）
CORS_ORIGIN=*

# AI 服务商：mock(离线) / openai / qwen / ernie / deepseek
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
QWEN_API_KEY=
DEEPSEEK_API_KEY=
