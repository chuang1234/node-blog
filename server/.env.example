# ===================== 服务基础配置 =====================
NODE_ENV=development
PORT=3000
# 前端地址，用于 CORS 白名单（多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 静态资源访问前缀（上传文件的对外地址）
STATIC_BASE_URL=http://localhost:3000

# ===================== MySQL 配置 =====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Chuang@123456
DB_NAME=ai_blog
DB_CONNECTION_LIMIT=10

# ===================== Redis 配置 =====================
# 若本地未安装 Redis，将 REDIS_ENABLED 设为 false，系统会自动降级为进程内存缓存
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 缓存 key 前缀
REDIS_PREFIX=ai_blog:

# ===================== JWT 鉴权 =====================
JWT_SECRET=please_change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===================== 文件上传 =====================
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# ===================== AI 大模型配置 =====================
# 可选值: openai | qwen | ernie | deepseek | mock
# mock 为内置离线模拟 Provider，无需任何 API Key 即可跑通全部 AI 功能（用于开发/演示）
AI_PROVIDER=mock
AI_TIMEOUT_MS=60000

# --- OpenAI / 任意 OpenAI 兼容接口（DeepSeek、Moonshot、硅基流动等）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 阿里云通义千问（DashScope OpenAI 兼容模式）---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- 百度文心一言（千帆 V2 OpenAI 兼容模式）---
ERNIE_API_KEY=
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
ERNIE_MODEL=ernie-4.0-8k

# --- DeepSeek（OpenAI 兼容接口）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===================== AI 限流 =====================
AI_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_DAY=200

# ===================== 通用接口限流 =====================
API_RATE_LIMIT_PER_MIN=300
